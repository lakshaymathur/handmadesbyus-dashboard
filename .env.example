# Copy to `.env` for local development: `cp .env.example .env`
# Every setting the app reads lives here. Values below are for LOCAL DEVELOPMENT ONLY;
# production sets its own through the host's environment.

# --- Database (PostgreSQL) -------------------------------------------------
# Used by docker-compose.yml to create the local server. If you change these,
# change the URLs below to match.
POSTGRES_USER=handmadesbyus
POSTGRES_PASSWORD=handmadesbyus
POSTGRES_DB=handmadesbyus
POSTGRES_TEST_DB=handmadesbyus_test
POSTGRES_PORT=5432

# Read by the app.
DATABASE_URL=postgres://handmadesbyus:handmadesbyus@localhost:5432/handmadesbyus
# Read by `npm run test:integration`. Tests wipe this database, so never point it at real data.
TEST_DATABASE_URL=postgres://handmadesbyus:handmadesbyus@localhost:5432/handmadesbyus_test

# --- File storage (any S3-compatible service) ------------------------------
# Locally this is SeaweedFS from docker-compose.yml, which uses these values
# to create its access key and bucket.
S3_ENDPOINT=http://localhost:8333
S3_PORT=8333
S3_REGION=us-east-1
S3_BUCKET=handmadesbyus
S3_ACCESS_KEY_ID=handmadesbyus
S3_SECRET_ACCESS_KEY=handmadesbyus-dev-secret
# true for SeaweedFS/MinIO-style servers (http://host/bucket/key); false for virtual-hosted style.
S3_FORCE_PATH_STYLE=true
