# Copy to `.env` for local development: `cp .env.example .env`
# Every setting the app reads lives here. Values below are for LOCAL DEVELOPMENT ONLY;
# production sets its own through the host's environment.

# --- Database (PostgreSQL) -------------------------------------------------
# Used by docker-compose.yml to create the local server. If you change these,
# change the URLs below to match.
POSTGRES_USER=handmadesbyus
POSTGRES_PASSWORD=handmadesbyus
POSTGRES_DB=handmadesbyus
POSTGRES_TEST_DB=handmadesbyus_test
POSTGRES_PORT=5432

# Read by the app.
DATABASE_URL=postgres://handmadesbyus:handmadesbyus@localhost:5432/handmadesbyus
# Read by `npm run test:integration`. Tests wipe this database, so never point it at real data.
TEST_DATABASE_URL=postgres://handmadesbyus:handmadesbyus@localhost:5432/handmadesbyus_test

# --- File storage (any S3-compatible service) ------------------------------
# Locally this is SeaweedFS from docker-compose.yml, which uses these values
# to create its access key and bucket.
S3_ENDPOINT=http://localhost:8333
S3_PORT=8333
S3_REGION=us-east-1
S3_BUCKET=handmadesbyus
S3_ACCESS_KEY_ID=handmadesbyus
S3_SECRET_ACCESS_KEY=handmadesbyus-dev-secret
# true for SeaweedFS/MinIO-style servers (http://host/bucket/key); false for virtual-hosted style.
S3_FORCE_PATH_STYLE=true

# --- Auth (Better Auth) ----------------------------------------------------
# Signs session cookies. Production needs its own: `openssl rand -base64 32`
# (`next start` refuses this example value).
BETTER_AUTH_SECRET=local-dev-only-secret-change-me-in-production
# Public URL of the app.
BETTER_AUTH_URL=http://localhost:3000
# Other addresses the app is opened at, comma-separated origins. To test on a phone on
# your Wi-Fi, add the Network URL that `npm run dev` prints, e.g. http://192.168.1.11:3000
TRUSTED_ORIGINS=

# Sign-in rate limiting is per client IP (plus a per-username cap). Clients can send any
# X-Forwarded-For, so in production either list the reverse proxy's IPs/CIDRs in
# TRUSTED_PROXIES, or set CLIENT_IP_HEADERS to a header the proxy always overwrites
# (x-real-ip, cf-connecting-ip). `next start` refuses x-forwarded-for with no proxies.
# Never expose the Node server directly. To try `next start` locally: TRUSTED_PROXIES=::1
CLIENT_IP_HEADERS=x-forwarded-for
TRUSTED_PROXIES=

# First login user, created by `npm run db:seed` if no user with this username exists.
# The seed refuses this example password unless the database is a disposable local one.
SEED_USER_USERNAME=admin
SEED_USER_NAME=Admin
SEED_USER_PASSWORD=local-dev-password
